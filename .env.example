# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Every value the code reads lives here so there are no magic numbers in source.

# ---- feed-service: tick generation ----
# How often each symbol emits a new tick. 0.25s = 4 ticks/sec/symbol:
# fast enough for Grafana rate() panels to move in a demo, gentle on a t3.micro DB.
TICK_INTERVAL_SECONDS=0.25
# Comma-separated. Kept small so "latest price per symbol" in Redis is a real map.
SYMBOLS=AAPL,GOOG,MSFT,AMZN
# Starting price for every symbol's random walk.
START_PRICE=100.0
# Std-dev of each random-walk step as a fraction of current price.
# 0.001 = ~0.1% per tick -> a few % drift per minute: visible, not absurd.
STEP_VOLATILITY=0.001

# ---- feed-service: Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulsecheck
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=change-me-locally

# ---- feed-service: Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- feed-service: startup retry (applies to Postgres and Redis) ----
# Exponential backoff between connection attempts: 1s, 2s, 4s, ... capped.
CONNECT_MAX_ATTEMPTS=10
CONNECT_BACKOFF_CAP_SECONDS=8
# Per-attempt connect timeout. Also the ceiling on how long /health can hang
# when a dependency is unreachable (timeout-based detection, not a signal).
CONNECT_TIMEOUT_SECONDS=3

# ---- feed-service: logging ----
# Path INSIDE the container. docker-compose bind-mounts ./logs here so the
# host log-watcher (M3) can tail it.
LOG_FILE=/app/logs/feed-service.log
LOG_LEVEL=INFO

# ---- watchdog / log-watcher (used from M3 onward) ----
# Consecutive failed checks before the watchdog acts. >1 so a single blip
# (one slow scrape, a GC pause) does not trigger a restart. See M4 notes.
BREACH_THRESHOLD=3
# SQLite incident log written by BOTH log-watcher and watchdog.
INCIDENTS_DB_PATH=incidents.db
# Discord Incoming Webhook URL. SECRET — real value only in .env, never committed.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/ placeholder
