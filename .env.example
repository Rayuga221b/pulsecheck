# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Every value the code reads lives here so there are no magic numbers in source.

# ---- feed-service: tick generation ----
# How often each symbol emits a new tick. 0.25s = 4 ticks/sec/symbol:
# fast enough for Grafana rate() panels to move in a demo, gentle on a t3.micro DB.
TICK_INTERVAL_SECONDS=0.25
# Comma-separated. Kept small so "latest price per symbol" in Redis is a real map.
SYMBOLS=AAPL,GOOG,MSFT,AMZN
# Starting price for every symbol's random walk.
START_PRICE=100.0
# Std-dev of each random-walk step as a fraction of current price.
# 0.001 = ~0.1% per tick -> a few % drift per minute: visible, not absurd.
STEP_VOLATILITY=0.001

# ---- feed-service: Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulsecheck
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=change-me-locally

# ---- feed-service: Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- feed-service: startup retry (applies to Postgres and Redis) ----
# Exponential backoff between connection attempts: 1s, 2s, 4s, ... capped.
CONNECT_MAX_ATTEMPTS=10
CONNECT_BACKOFF_CAP_SECONDS=8
# Per-attempt connect timeout. Also the ceiling on how long /health can hang
# when a dependency is unreachable (timeout-based detection, not a signal).
CONNECT_TIMEOUT_SECONDS=3

# ---- feed-service: logging ----
# Path INSIDE the container. docker-compose bind-mounts ./logs here so the
# host log-watcher (M3) can tail it.
LOG_FILE=/app/logs/feed-service.log
LOG_LEVEL=INFO

# ---- watchdog / log-watcher (used from M3 onward) ----
# Consecutive failed checks before the watchdog acts. >1 so a single blip
# (one slow scrape, a GC pause) does not trigger a restart. See M4 notes.
BREACH_THRESHOLD=3
# SQLite incident log written by BOTH log-watcher and watchdog.
INCIDENTS_DB_PATH=incidents.db
# Slack Incoming Webhook URL. SECRET — real value only in .env, never committed.
# Unset => the watchdog still runs, logs and records incidents, but skips Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/placeholder

# ---- watchdog (M4) — host process, polls the feed-service container ----
# Seconds between polls. Detection latency for a hard-down is roughly
# WATCHDOG_POLL_SECONDS * BREACH_THRESHOLD (~6s at 2.0 * 3): fast enough for an
# L1 auto-recovery aid, slow enough not to react to sub-second blips.
WATCHDOG_POLL_SECONDS=2.0
# The /health URL to poll. feed-service publishes 8000 to the host, and the
# watchdog runs on the host, so this is localhost — not the container name.
WATCHDOG_HEALTH_URL=http://localhost:8000/health
# Per-poll HTTP timeout. Also the ceiling on how long one poll can hang when the
# app is wedged (detection is timeout-based, there is no "I'm stuck" signal).
WATCHDOG_HEALTH_TIMEOUT_SECONDS=3.0
# Container to watch and restart. Matches container_name in docker-compose.yml so
# the docker-py lookup is stable.
WATCHDOG_CONTAINER=pulsecheck-feed-service
# SIGTERM -> SIGKILL grace period passed to `docker restart`.
WATCHDOG_RESTART_TIMEOUT_SECONDS=10
# Consecutive *healthy* polls needed to declare recovery and close the incident.
# 1 on purpose: a premature "resolved" is cheap (the next bad poll re-opens one),
# whereas a premature "it's down" triggers a real restart — hence the asymmetry
# with BREACH_THRESHOLD.
WATCHDOG_RECOVERY_CONFIRMATIONS=1
# docker-py honours DOCKER_HOST when set. Leave unset on the EC2 box (default
# /var/run/docker.sock). With Colima locally, point it at the Colima socket:
# DOCKER_HOST=unix:///Users/<you>/.colima/default/docker.sock

# ---- log-watcher (M3) — host process, tails the JSON log ----
# Host-side path to the feed-service log (the container writes it to the
# ./logs bind mount, so from the host it's just logs/feed-service.log).
LOG_WATCHER_LOG_FILE=logs/feed-service.log
# Poll interval for the file tail. 1s: an incident that matters has already
# lasted seconds; sub-second polling would be noise.
LOG_WATCHER_POLL_SECONDS=1.0
# Error-burst rule: N ERROR lines within W seconds. feed-service attempts ~16
# writes/s, so a real outage trips this within ~1s; a lone recovered blip won't.
LOG_WATCHER_ERROR_BURST_COUNT=5
LOG_WATCHER_ERROR_BURST_WINDOW_SECONDS=20
# Repeated-connection-failure rule: N of the app's own `dependency_retry` lines
# within W seconds. App backoff is 1,2,4,8s, so 3 retries ≈ 7s+ unreachable.
LOG_WATCHER_CONN_FAIL_COUNT=3
LOG_WATCHER_CONN_FAIL_WINDOW_SECONDS=60
# After any rule fires it stays quiet this long (log-time) so one sustained
# fault is one incident row, not hundreds.
LOG_WATCHER_COOLDOWN_SECONDS=120
# Event tags / substrings that are an incident at any rate — the service saying
# it has already given up.
LOG_WATCHER_KNOWN_MARKERS=dependency_unreachable,generator_reconnect_failed
